{
  "name": "hexaram-assistant",
  "version": "0.2.0-beta.1",
  "private": true,
  "description": "Windows 海克斯大乱斗开源随局助手",
  "author": "HexARAM contributors",
  "license": "MIT",
  "type": "module",
  "main": "apps/desktop/electron/main.cjs",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:desktop": "node tests/electron-smoke.mjs",
    "start": "electron .",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "pack:win": "pnpm build && electron-builder --win --x64 --dir",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:sync": "node scripts/sync-catalog.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "org.hexaram.assistant",
    "productName": "HexARAM Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "apps/desktop/electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "HexARAM-Assistant-${version}-Windows-x64-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "海克斯大乱斗助手"
    }
  }
}
